<h1>Incidents</h1>
<table border="1" cellpadding="8">
  <tr><th>Title</th><th>Status</th><th></th></tr>
  <% @incidents.each do |inc| %>
    <tr>
      <td><%= inc.title %></td>
      <td><%= inc.status %></td>
      <td><%= link_to "View", incident_path(inc) %></td>
    </tr>
  <% end %>
</table>
<p><%= link_to "← Back", root_path %></p>
